// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "profiles": {
      "test": {
        "default_model": {
          "provider": "ollama",
          "model": "qwen2.5-coder:3b",
          "enable_thinking": false
        },
        "name": "test",
        "tools": {
          "open": true,
          "create_directory": true,
          "grep": true,
          "spawn_agent": true,
          "save_file": true,
          "read_file": true,
          "list_directory": true,
          "edit_file": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "dock": "right",
    "default_profile": "ask",
    "default_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:7b",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "soft_wrap": "preferred_line_length",
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Ayu Mirage",
  },
}
